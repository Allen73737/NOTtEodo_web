{
  "name": "notteodo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm sync:all",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && pnpm lint:colors",
    "lint:colors": "tsx scripts/lint-colors.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync:tokens": "tsx scripts/sync-tokens.ts",
    "sync:content": "tsx scripts/sync-content.ts",
    "sync:screenshots": "tsx scripts/sync-screenshots.ts",
    "sync:logo": "tsx scripts/trace-logo.ts && tsx scripts/make-icons.ts",
    "sync:all": "tsx scripts/sync-tokens.ts && tsx scripts/sync-content.ts && tsx scripts/sync-screenshots.ts && tsx scripts/hash-theme-script.ts",
    "check:drift": "tsx scripts/sync-tokens.ts --check && tsx scripts/sync-content.ts --check && tsx scripts/sync-screenshots.ts --check && tsx scripts/trace-logo.ts --check",
    "posters": "tsx poster-studio/render.ts",
    "check:server-only": "tsx scripts/check-server-only.ts"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "detect-gpu": "5.0.70",
    "gsap": "3.15.1",
    "hash-wasm": "4.13.0",
    "lenis": "1.3.27",
    "lucide-react": "1.77.0",
    "minisearch": "7.2.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "three": "0.187.0",
    "three-stdlib": "2.36.1",
    "tus-js-client": "4.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.17",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/opentype.js": "1.3.10",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "opentype.js": "2.0.0",
    "postcss": "8.5.33",
    "potrace": "2.1.8",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
